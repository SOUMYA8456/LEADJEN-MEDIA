# ==============================================================================
# LEADJEN MEDIA — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (PostgreSQL 15+ / Neon / Supabase / AWS RDS / Prisma Accelerate)
DATABASE_URL="postgresql://username:password@hostname:5432/leadjen_news?schema=public&sslmode=require"
# Optional direct URL for connection poolers (e.g. PgBouncer / Prisma Accelerate)
DIRECT_URL=""

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="generate-a-secure-random-32-byte-hex-or-base64-string"

# Initial Super Admin Provisioning (Used during initial setup/seed)
ADMIN_EMAIL="admin@leadjenmedia.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# Public Website & Canonical URL (Must be HTTPS in production)
NEXT_PUBLIC_SITE_URL="https://leadjen-media-news.vercel.app"

# Cron Authentication Secret (Protects /api/cron/publish endpoint)
CRON_SECRET="generate-a-secure-random-token-for-cron-triggers"

# Optional Cloudinary Media Storage Provider
# If unconfigured, the system automatically uses permanent PostgreSQL byte storage fallback.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional SMTP Email Provider (For newsletter distribution if configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="editorial@leadjenmedia.com"

# Node Environment (development | staging | production)
NODE_ENV="production"
